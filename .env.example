# InvestBot — variables de entorno (plantilla, sin valores reales)
# Copiar a .env y completar. .env nunca se commitea (ver .gitignore).
# En el VPS: chmod 600 .env, propietario el usuario sin privilegios root (mismo patrón que FoodMindAI).

# Token del bot de Telegram, obtenido de @BotFather (ver contexto/referencia/SETUP_TELEGRAM_BOT.md)
TELEGRAM_BOT_TOKEN=

# Uno o más chat_id autorizados (CSV), ej. Daniela + hasta 2 personas más.
# Un solo entero (formato actual) sigue siendo válido sin cambios: TELEGRAM_ALLOWED_CHAT_ID=12345
# Múltiples chat_id separados por coma: TELEGRAM_ALLOWED_CHAT_ID=12345,67890,11223
# Sin esta variable (o si contiene algún elemento inválido) el proceso NO arranca —
# fail-closed intencional, ver security.py.
TELEGRAM_ALLOWED_CHAT_ID=

# API key del plan gratuito de Financial Modeling Prep (https://financialmodelingprep.com)
# Plan gratuito: 250 requests/día. Ver README.md sección "Plan de FMP".
FMP_API_KEY=

# API key gratuita de FRED (Federal Reserve Economic Data) para la serie DGS20
# (rendimiento del bono del tesoro EEUU a 20 años). Registro instantáneo y gratuito en
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# API key OPCIONAL de Finnhub (https://finnhub.io) para peers dinámicos por
# sector/sub-industria. Si se deja vacía, el bot usa automáticamente la lista
# fija de respaldo (peers.py::PEERS_BY_SECTOR) — nunca falla por esto.
# Free tier: 60 llamadas/minuto, sin tarjeta. Ver README.md.
FINNHUB_API_KEY=

# User-Agent OBLIGATORIO para llamar a SEC EDGAR (eventos corporativos vía
# 8-K). La SEC exige identificar el bot/app + un contacto real (email) en
# cada request -- si se deja vacía, el bot funciona igual pero esta sección
# se omite siempre (nunca se llama a SEC EDGAR sin este header). Formato:
# "<nombre/app> <email-de-contacto>", ej. "InvestBot contacto@ejemplo.com"
SEC_EDGAR_USER_AGENT=

# Ruta del archivo SQLite dentro del contenedor (volumen Docker). Default: /data/investbot.db
INVESTBOT_DB_PATH=/data/investbot.db

# Nivel de logging general de la aplicación (no de httpx/httpcore/telegram, que siempre
# quedan fijados a WARNING en producción independientemente de esta variable — ver bot.py)
LOG_LEVEL=INFO

# --- Redacción mejorada por IA local (Ollama) — OPCIONAL, feature opt-in ---
# apagada por defecto (SDD_redaccion_ia_ollama.md). Post-procesa el TONO del
# mensaje ya armado (nunca cambia ningún número/ticker/veredicto — guard de
# integridad determinístico en ai_rewrite.py, no una instrucción de prompt).
# Depende de que la PC de Daniela esté PRENDIDA y alcanzable por Tailscale
# (VPS <-> PC, sin puertos publicados en ningún extremo — ver
# contexto/referencia/SETUP_TELEGRAM_BOT.md, sección "Ollama + Tailscale").
# Si la PC está apagada o no responde a tiempo, el bot funciona exactamente
# igual que con la feature deshabilitada (fallback silencioso, sin error
# visible para el usuario).

# "true"/"1"/"yes" (case-insensitive) para habilitar. Cualquier otro valor
# (incluida esta variable sin setear) = deshabilitado. Con esta variable
# deshabilitada, OLLAMA_BASE_URL ni siquiera se lee.
OLLAMA_REWRITE_ENABLED=false

# URL base de Ollama en la PC de Daniela, alcanzable SOLO vía la IP del
# tailnet de Tailscale (NUNCA una IP de LAN ni pública — ver checklist de
# aislamiento del puerto 11434 en SETUP_TELEGRAM_BOT.md). Ej.:
# OLLAMA_BASE_URL=http://100.101.102.103:11434
# Vacía (o sin setear) = feature deshabilitada aunque OLLAMA_REWRITE_ENABLED
# sea true (defensivo).
OLLAMA_BASE_URL=

# Modelo de Ollama a usar. Default recomendado: qwen2.5:7b-instruct (7B,
# corre en CPU/GPU modesta de una PC personal, buen desempeño en español).
# Cambiar acá no requiere tocar código ni redeploy más que reiniciar el bot.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Read timeout en segundos para la llamada a Ollama (el connect timeout
# queda fijo en 3.0s, no configurable). Default: 8.0. Si Ollama no responde
# a tiempo, el bot cae al texto original sin reescritura, sin error visible.
OLLAMA_TIMEOUT_SECONDS=8.0

# OPCIONAL, capa de defensa en profundidad ADICIONAL (recomendada por
# `security`, no bloqueante, NO implementada en el código de esta iteración
# — ver SETUP_TELEGRAM_BOT.md, sección 2.5). Solo tendría efecto si en el
# futuro se agrega un reverse proxy con shared-secret delante de Ollama en
# la PC + el envío del header correspondiente desde ai_rewrite.py. Hoy,
# dejarla vacía (o directamente no setearla) — no la lee ningún código
# todavía, documentada acá solo como reserva de nombre para esa mejora futura.
OLLAMA_SHARED_SECRET=
